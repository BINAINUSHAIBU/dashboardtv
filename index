<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BTECH TV Admin Dashboard</title>

<link rel="stylesheet" href="css/style.css">

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, sans-serif;
}

body{
background:#0f172a;
color:#fff;
}

.dashboard-container{
display:flex;
min-height:100vh;
}

/* SIDEBAR */
.sidebar{
width:250px;
background:#111827;
padding:20px;
}

.sidebar h2{
color:#00d4ff;
margin-bottom:30px;
text-align:center;
}

.sidebar ul{
list-style:none;
}

.sidebar ul li{
margin:15px 0;
padding:12px;
border-radius:10px;
transition:0.3s;
}

.sidebar ul li:hover,
.sidebar ul li.active{
background:#1e293b;
}

.sidebar ul li a{
color:#fff;
text-decoration:none;
display:block;
}

/* MAIN */
.dashboard-main{
flex:1;
padding:25px;
}

.dashboard-header{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:30px;
}

.dashboard-header h1{
font-size:28px;
}

/* STATS */
.stats-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:20px;
margin-bottom:30px;
}

.stat-card{
background:#1e293b;
padding:25px;
border-radius:15px;
box-shadow:0 0 10px rgba(0,0,0,0.3);
}

.stat-card h3{
font-size:18px;
margin-bottom:10px;
color:#cbd5e1;
}

.stat-card p{
font-size:28px;
font-weight:bold;
color:#00d4ff;
}

/* TABLE */
.channel-section{
background:#1e293b;
padding:20px;
border-radius:15px;
}

.channel-section h2{
margin-bottom:20px;
}

table{
width:100%;
border-collapse:collapse;
}

table th,
table td{
padding:15px;
text-align:left;
border-bottom:1px solid #334155;
}

table th{
color:#00d4ff;
}

.status{
padding:6px 12px;
border-radius:20px;
font-size:13px;
font-weight:bold;
display:inline-block;
}

.free{
background:#16a34a;
}

.paid{
background:#dc2626;
}

.locked{
background:#f59e0b;
}

.unlocked{
background:#2563eb;
}

button{
padding:8px 14px;
border:none;
border-radius:8px;
cursor:pointer;
font-weight:bold;
}

.lock-btn{
background:#f59e0b;
color:#fff;
}

.edit-btn{
background:#00d4ff;
color:#000;
}

@media(max-width:768px){
.sidebar{
display:none;
}

.dashboard-main{
padding:15px;
}
}
</style>
</head>

<body>

<div class="dashboard-container">

<!-- SIDEBAR -->
<aside class="sidebar">
<h2>BTECH TV</h2>

<ul>
<li class="active">
<a href="#">Dashboard</a>
</li>

<li>
<a href="#">All Channels</a>
</li>

<li>
<a href="#">Free Channels</a>
</li>

<li>
<a href="#">Pay To View</a>
</li>

<li>
<a href="#">Locked Channels</a>
</li>

<li>
<a href="#">Users</a>
</li>

<li>
<a href="#">Subscription Plans</a>
</li>

<li>
<a href="#">Settings</a>
</li>
</ul>
</aside>

<!-- MAIN -->
<main class="dashboard-main">

<header class="dashboard-header">
<h1>BTECH TV Channel Dashboard</h1>
</header>

<!-- STATS -->
<section class="stats-grid">

<div class="stat-card">
<h3>Total Channels</h3>
<p>20,000</p>
</div>

<div class="stat-card">
<h3>Free Channels</h3>
<p>12,500</p>
</div>

<div class="stat-card">
<h3>Pay To View</h3>
<p>6,800</p>
</div>

<div class="stat-card">
<h3>Locked Channels</h3>
<p>700</p>
</div>

</section>

<!-- CHANNEL TABLE -->
<section class="channel-section">

<h2>Channel Management</h2>

<table>

<thead>
<tr>
<th>Channel Name</th>
<th>Category</th>
<th>Type</th>
<th>Lock Status</th>
<th>Actions</th>
</tr>
</thead>

<tbody>

<tr>
<td>BTECH Sports HD</td>
<td>Sports</td>
<td>
<span class="status paid">Pay To View</span>
</td>
<td>
<span class="status locked">Locked</span>
</td>
<td>
<button class="lock-btn">Unlock</button>
<button class="edit-btn">Edit</button>
</td>
</tr>

<tr>
<td>BTECH Movies</td>
<td>Entertainment</td>
<td>
<span class="status free">Free</span>
</td>
<td>
<span class="status unlocked">Unlocked</span>
</td>
<td>
<button class="lock-btn">Lock</button>
<button class="edit-btn">Edit</button>
</td>
</tr>

<tr>
<td>BTECH Kids</td>
<td>Kids</td>
<td>
<span class="status free">Free</span>
</td>
<td>
<span class="status unlocked">Unlocked</span>
</td>
<td>
<button class="lock-btn">Lock</button>
<button class="edit-btn">Edit</button>
</td>
</tr>

<tr>
<td>BTECH Premium Cinema</td>
<td>Movies</td>
<td>
<span class="status paid">Pay To View</span>
</td>
<td>
<span class="status locked">Locked</span>
</td>
<td>
<button class="lock-btn">Unlock</button>
<button class="edit-btn">Edit</button>
</td>
</tr>

<tr>
<td>BTECH News Live</td>
<td>News</td>
<td>
<span class="status free">Free</span>
</td>
<td>
<span class="status unlocked">Unlocked</span>
</td>
<td>
<button class="lock-btn">Lock</button>
<button class="edit-btn">Edit</button>
</td>
</tr>

</tbody>
</table>

</section>

</main>
</div>

<script>
// Example Lock/Unlock Function
const lockButtons = document.querySelectorAll(".lock-btn");

lockButtons.forEach(button => {
button.addEventListener("click", () => {

if(button.innerText === "Lock"){
button.innerText = "Unlock";
} else {
button.innerText = "Lock";
}

});
});
</script>

</body>
</html>
